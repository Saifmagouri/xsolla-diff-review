# Bearer token required on all /v1/* routes. This is the token you hand to graders.
BEARER_TOKEN=replace-with-a-long-random-token

# Port the service listens on (Fly.io internal port defaults to 8080).
PORT=8080

# --- LLM provider (Groq, OpenAI-compatible API) ---
# Required only if you exercise the "llm" provider. Absent/invalid -> jobs fail gracefully.
GROQ_API_KEY=
# Model id. Default is openai/gpt-oss-120b (do NOT use llama-3.3-70b: decommissioned 2026-08-16).
LLM_MODEL=openai/gpt-oss-120b
# Groq OpenAI-compatible base URL.
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Per-call timeout in milliseconds.
LLM_TIMEOUT_MS=30000
